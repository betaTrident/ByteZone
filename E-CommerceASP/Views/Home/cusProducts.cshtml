@{
    Layout = null;
}

@using System;
@using System.Collections.Generic;
@using System.Linq;
@using System.Web;
@using System.Web.Mvc;
@using System.Data;
@using System.Data.SqlClient;
@using System.IO;

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>ByteZone</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <link href="~/Style/adminStyles.css" rel="stylesheet" />
  
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container">

            <a class="navbar-brand" href="https://localhost:44397/Home/cusHomepage">
                <img src="~/Scripts/images/OfficialLogo_ByteZone.png" />
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topNavbar"
                    aria-controls="topNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-end" id="topNavbar">
                <div class="d-flex align-items-center">

                    <form class="search-form mr-3">
                        <input class="form-control mr-sm-2 search-input" type="search" placeholder="Search" aria-label="Search" name="searchQuery">
                        <button class="btn btn-outline-light my-2 my-sm-0 search-button" type="submit">Search</button>
                    </form>


                    <div class="dropdown">
                        <button class="btn btn-secondary dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown"
                                aria-expanded="false">
                            @(Session["UserName"])
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                            <li><a class="dropdown-item" href="#" id="myaccountBtn">My Account</a></li>
                            <li><a class="dropdown-item" href="#" id="logoutBtn">Logout</a></li>
                        </ul>
                    </div>
                </div>
            </div>

        </div>
    </nav>
   
    <nav class="navbar navbar-expand-lg navbar-dark bg-secondary fixed-top bottom-navbar" style="z-index: 900;">
        <div class="container">
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#bottomNavbar"
                    aria-controls="bottomNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
           
            <div class="collapse navbar-collapse justify-content-center" id="bottomNavbar">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="https://localhost:44397/Home/cusHomepage">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="https://localhost:44397/Home/cusProducts?searchQuery=">Products</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="https://localhost:44397/Home/cusAddToCart">My Cart</a>
                    </li>
                    
                </ul>
            </div>
        </div>
    </nav>



    <div class="container">

        <h1 class="text-center my-4">Products</h1>
        <div class="d-flex justify-content-between align-items-center mb-3">

            <div class="dropdown">
                <button class="btn btn-secondary dropdown-toggle" type="button" id="sortDropdownButton" data-bs-toggle="dropdown" aria-expanded="false">
                    Sort By
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="sortDropdownButton">
                    <li><button class="dropdown-item sort-btn" data-sort="prod_ID">ID</button></li>
                    <li><button class="dropdown-item sort-btn" data-sort="prod_name">Name</button></li>
                    <li><button class="dropdown-item sort-btn" data-sort="prod_brand">Brand</button></li>

                    <li><button class="dropdown-item sort-btn" data-sort="prod_quantity">Quantity</button></li>
                    <li><button class="dropdown-item sort-btn" data-sort="prod_price">Price</button></li>

                </ul>
            </div>
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th class="hidden">ID</th>
                    <th>Name</th>
                    <th>Brand</th>
                    <th>Description</th>
                    <th>Available Pieces</th>
                    <th>Price</th>
                    <th>Image</th>

                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="productTableBody">
                @{
                    string connStr = @"Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=C:\Users\Dennis\source\repos\E-CommerceASP\E-CommerceASP\App_Data\byteZone.mdf;Integrated Security=True";

                    using (var db = new SqlConnection(connStr))
                    {
                        db.Open();

                        using (var cmd = db.CreateCommand())
                        {
                            cmd.CommandType = CommandType.Text;
                            cmd.CommandText = "SELECT* FROM PRODUCTS WHERE prod_quantity > 0 AND prod_name LIKE @searchQuery";
                            cmd.Parameters.AddWithValue("@searchQuery", "%" + Request.QueryString["searchQuery"] + "%");

                            using (var reader = cmd.ExecuteReader())
                            {
                                if (reader.HasRows)
                                {
                                    while (reader.Read())
                                    {
                                        <tr class="items">
                                            <td class="hidden"><label>@reader["prod_ID"]</label></td>
                                            <td class="prodName" style="font-weight:bold;">@reader["prod_name"]</td>
                                            <td class="prodBrand">@reader["prod_brand"]</td>
                                            <td class="prodDesc" style="max-width: 325px;">@reader["prod_description"]</td>
                                            <td class="prodQuantity" style="text-align: center;">@reader["prod_quantity"]</td>
                                            <td class="prodPrice">₱ @reader["prod_price"]</td>
                                            <td class="prodImg">
                                                <img src="@Url.Action("Image", "Home", new { filename = reader["prod_img"] })" width="100" />
                                            </td>

                                            <td style="white-space:nowrap">
                                                <div class="input-group" style="width: fit-content;">
                                                    <div class="input-group-prepend">
                                                        <button class="btn btn-outline-primary btn-sm btn-decrement" type="button" onclick="decrementQuantity()">-</button>
                                                    </div>
                                                    <input type="number" class="form-control form-control-sm input-quantity text-center quantityInput" value="1" min="1" style="width: 3em; padding: 0;" onkeydown="return false">

                                                    <div class="input-group-append">
                                                        <button class="btn btn-outline-primary btn-sm btn-increment" type="button" onclick="incrementQuantity()">+</button>
                                                    </div>
                                                </div>
                                                <div class="mt-2">

                                                    <button class="btn btn-primary btn-sm btn-add-to-cart" data-id="@reader["prod_ID"]">Add to Cart</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="9">No matching products found.</td>
                                    </tr>
                                }
                            }
                        }
                    }
                }
            </tbody>

        </table>
    </div>


   
    <div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="staticBackdropLabel">Create New Product</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="productForm" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input class="form-control" id="prodName" name="prodName" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Brand</label>
                            <input class="form-control" id="prodBrand" name="prodBrand" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Category</label>
                            <select class="form-select" id="prodCategory" name="prodCategory">
                                <option value="Other">Other</option>
                                <option value="Phones">Phones</option>
                                <option value="Laptops">Laptops</option>
                                <option value="Computers">Computers</option>
                                <option value="Accessories">Accessories</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Price</label>
                            <input class="form-control" id="prodPrice" name="prodPrice" type="number" step="0.01" min="0" value="0.0" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <input class="form-control" id="prodDesc" name="prodDesc" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Quantity</label>
                            <input class="form-control" id="prodQuantity" name="prodQuantity" type="number" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Product Image</label>
                            <input class="form-control" id="prodImg" name="prodImg" type="file" accept="image/png,image/jpeg,image/jpg,image/gif,image/bmp" required />
                        </div>
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            <button type="submit" class="btn btn-primary">Submit</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>


   
    <div class="modal fade" id="createSuccessModal" tabindex="-1" aria-labelledby="createSuccessModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="createSuccessModalLabel">Success</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Product created successfully.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

   
    <div class="modal fade" id="deleteConfirmationModal" tabindex="-1" aria-labelledby="deleteConfirmationModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteConfirmationModalLabel">Delete Product</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete this product?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <a id="deleteConfirmationLink" href="" class="btn btn-danger">Confirm</a>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteSuccessModal" tabindex="-1" role="dialog" aria-labelledby="deleteSuccessModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteSuccessModalLabel">Product Deleted</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    The product has been deleted successfully.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    
    <div class="modal fade" id="updateModal" tabindex="-1" aria-labelledby="updateModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="updateModalLabel">Update Product</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="updateForm" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input class="form-control" id="updateProdName" name="prodName" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Brand</label>
                            <input class="form-control" id="updateProdBrand" name="prodBrand" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Category</label>
                            <select class="form-select" id="updateProdCategory" name="prodCategory">
                                <option value="Other">Other</option>
                                <option value="Phones">Phones</option>
                                <option value="Laptops">Laptops</option>
                                <option value="Computers">Computers</option>
                                <option value="Accessories">Accessories</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Price</label>
                            <input class="form-control" id="updateProdPrice" name="prodPrice" type="number" step="0.01" min="0" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <input class="form-control" id="updateProdDesc" name="prodDesc" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Quantity</label>
                            <input class="form-control" id="updateProdQuantity" name="prodQuantity" type="number" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Product Image</label>
                            <input class="form-control" id="updateProdImg" name="prodImg" type="file" accept="image/png,image/jpeg,image/jpg,image/gif,image/bmp" />
                        </div>
                        <input type="hidden" id="updateProdId" name="prodId" />
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            <button type="submit" class="btn btn-primary">Update</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
   
    <div class="modal fade" id="logoutSuccessModal" tabindex="-1" aria-labelledby="logoutSuccessModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="logoutSuccessModalLabel">Logout Success</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    You have been successfully logged out.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    
    <div class="modal fade" id="updateUserInfoModal" tabindex="-1" aria-labelledby="updateUserInfoModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="updateUserInfoModalLabel">Update User Information</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="updateUserInfoForm">
                        <div class="mb-3">
                            <label for="updateFullName" class="form-label">Full Name</label>
                            <input type="text" class="form-control" id="updateFullName" placeholder="Full Name">
                        </div>
                        <div class="mb-3">
                            <label for="updateEmail" class="form-label">Email Address</label>
                            <input type="email" class="form-control" id="updateEmail" placeholder="Email Address">
                        </div>
                        <div class="mb-3">
                            <label for="updateAddress" class="form-label">Address</label>
                            <input type="text" class="form-control" id="updateAddress" placeholder="Address">
                        </div>
                        <div class="mb-3">
                            <label for="updatePhoneNumber" class="form-label">Phone Number</label>
                            <input type="text" class="form-control" id="phoneNumber" placeholder="Phone Number" pattern="\d{11}" maxlength="11">
                        </div>
                        <div class="mb-3">
                            <label for="updateBirthdate" class="form-label">Birthdate</label>
                            <input type="date" class="form-control" id="updateBirthdate" placeholder="Birthdate">
                        </div>
                        <div class="mb-3">
                            <label for="updatePassword" class="form-label">Password</label>
                            <input type="password" class="form-control" id="updatePassword" placeholder="Password" required>
                        </div>
                        <div class="mb-3">
                            <label for="updateConfirmPassword" class="form-label">Confirm Password</label>
                            <input type="password" class="form-control" id="updateConfirmPassword" placeholder="Confirm Password" required>
                        </div>
                        <div class="modal-footer justify-content-center">
                            <button type="submit" class="btn btn-primary">Update Information</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@(Url.Content("@popperjs/core@2.9.2/dist/umd/popper.min.js"))"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/jquery-3.7.1.js"></script>

    <script type="text/javascript">
    $(document).ready(function () {
        $(document).ready(function () {
            $('#logoutBtn').click(function (e) {
                e.preventDefault();


                $('#logoutSuccessModal').modal('show');
                
                setTimeout(function () {
                    window.location.href = 'https://localhost:44397/Home/Homepage';
                }, 1000);
            });
        });
        
        $('#productForm').on('submit', function (e) {
            e.preventDefault();

            var formData = new FormData(this);

            $.ajax({
                type: 'POST',
                url: '../Home/ProductEntryForm',
                data: formData,
                contentType: false,
                processData: false,
                success: function (response) {
                    $('#createSuccessModal').modal('show');
                    setTimeout(function () {
                        $('#createSuccessModal').modal('hide');
                        location.reload();
                    }, 2000); 
                },
                error: function (error) {
                    alert('There was an error creating the product. Please try again.');
                }
            });
        });

        
        function openUpdateModal(prod_ID) {
            $.ajax({
                url: '@Url.Action("GetProductData", "Home")',
                type: 'GET',
                data: { prod_ID: prod_ID },
                success: function (data) {
                    $('#updateProdId').val(data.prod_ID);
                    $('#updateProdName').val(data.prod_name);
                    $('#updateProdBrand').val(data.prod_brand);
                    $('#updateProdCategory').val(data.prod_category);
                    $('#updateProdPrice').val(data.prod_price);
                    $('#updateProdDesc').val(data.prod_desc);
                    $('#updateProdQuantity').val(data.prod_quantity);
                    $('#updateModal').modal('show');
                },
                error: function (error) {
                    console.log(error);
                }
            });
        }

       
        $('#updateForm').submit(function (event) {
            event.preventDefault();
            var formData = new FormData(this);
            $.ajax({
                url: '@Url.Action("UpdateProduct", "Home")',
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function (response) {
                    $('#updateModal').modal('hide');
                    alert('Product updated successfully!');
                    location.reload();
                },
                error: function (error) {
                    alert('Failed to update product!');
                }
            });
        });

        $('.sort-btn').click(function () {
            var sortBy = $(this).data('sort');
            sortTable(sortBy);
        });
        function openUpdateUserInfoModal() {
            $.ajax({
                url: '/Home/GetCustomerData',
                type: 'GET',
                success: function (response) {
                    if (response.success) {
                        $('#updateFullName').val(response.customer.full_name);
                        $('#updateEmail').val(response.customer.email);
                        $('#updateAddress').val(response.customer.address);
                        $('#updatePhoneNumber').val(response.customer.phone_number);
                        $('#updateBirthdate').val(response.customer.birthdate);
                        $('#updateUserInfoModal').modal('show');
                    } else {
                        alert('Failed to load customer data: ' + response.message);
                    }
                },
                error: function (error) {
                    alert('An error occurred while loading customer data.');
                }
            });
        }

        $('#updateUserInfoForm').submit(function (event) {
            event.preventDefault();
            var formData = {
                full_name: $('#updateFullName').val(),
                email: $('#updateEmail').val(),
                address: $('#updateAddress').val(),
                phone_number: $('#updatePhoneNumber').val(),
                birthdate: $('#updateBirthdate').val(),
                password: $('#updatePassword').val(),
                confirm_password: $('#updateConfirmPassword').val()
            };

            $.ajax({
                url: '/Home/UpdateCustomerData',
                type: 'POST',
                data: formData,
                success: function (response) {
                    if (response.success) {
                        $('#updateUserInfoModal').modal('hide');
                        alert('Customer information updated successfully!');
                    } else {
                        alert('Failed to update customer information: ' + response.message);
                    }
                },
                error: function (error) {
                    alert('An error occurred while updating customer information.');
                }
            });
        });

       
        $(document).ready(function () {
            $('#myaccountBtn').click(function (e) {
                e.preventDefault();
                openUpdateUserInfoModal();
            });
        });


       
        function sortTable(sortBy) {
            $.ajax({
                url: '@Url.Action("GetSortedProducts", "Home")',
                type: 'GET',
                data: { sortBy: sortBy },
                success: function (data) {
                    
                    $('#productTableBody').empty();
                    
                    $.each(data, function (index, product) {
                        var row = $('<tr class="items"></tr>');
                        row.append('<td class="hidden">' + product.prod_ID + '</td>');
                        row.append('<td class="prodName" style="font-weight: bold;">' + product.prod_name + '</td>');
                        row.append('<td class="prodBrand">' + product.prod_brand + '</td>');
                        row.append('<td class="prodDesc" style="max-width: 325px;">' + product.prod_description + '</td>');
                        row.append('<td class="prodQuantity">' + product.prod_quantity + '</td>');
                        row.append('<td class="prodPrice">₱' + product.prod_price + '.00</td>');
                        row.append('<td class="prodImg"><img src="' + product.prod_img + '" width="100"></td>');
                        row.append('<td style="white-space:nowrap"><div class="input-group" style="width: fit-content;"><div class="input-group-prepend"><button class="btn btn-outline-primary btn-sm btn-decrement" type="button" onclick="decrementQuantity()">-</button></div><input type="number" class="form-control form-control-sm input-quantity text-center quantityInput" value="1" min="1" style="width: 3em; padding: 0;" onkeydown="return false"><div class="input-group-append"><button class="btn btn-outline-primary btn-sm btn-increment" type="button" onclick="incrementQuantity()">+</button></div></div><div class="mt-2"><button class="btn btn-primary btn-sm btn-add-to-cart" data-id="' + product.prod_ID + '">Add to Cart</button></div>');
                        $('#productTableBody').append(row);
                    });

                  
                    attachAddToCartEventListeners();
                },
                error: function (error) {
                    alert('Failed to sort products!');
                }
            });
        }

        
        function attachAddToCartEventListeners() {
            $('.btn-add-to-cart').off('click').on('click', function () {
                var productId = $(this).data('id'); 

                
                var productName = $(this).closest('.items').find('.prodName').text();
                var productPrice = $(this).closest('.items').find('.prodPrice').text();
                var productQuantity = $(this).closest('.items').find('.quantityInput').val();

               
                $.ajax({
                    url: '/Home/AddToCart',
                    type: 'POST',
                    data: {
                        productId: productId,
                        quantity: productQuantity
                    },
                    success: function (response) {
                        if (response.success) {
                            
                            var row = `<tr>
                                <td>${productId}</td>
                                <td>${productName}</td>
                                <td>${productPrice}</td>
                                <td>${productQuantity}</td>
                            </tr>`;
                            $('#cartTableBody').append(row);
                            alert("Product added to cart successfully!");
                        } else {
                            
                            alert(response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                     
                        alert("An error occurred: " + error);
                    }
                });
            });
        }

        
        function incrementQuantity(button) {
            var input = button.closest('.input-group').querySelector('.quantityInput');
            var value = parseInt(input.value, 10);
            input.value = value + 1;
        }

        
        function decrementQuantity(button) {
            var input = button.closest('.input-group').querySelector('.quantityInput');
            var value = parseInt(input.value, 10);
            if (value > 1) {
                input.value = value - 1;
            }
        }

        var incrementButtons = document.querySelectorAll('.btn-increment');
        incrementButtons.forEach(function (button) {
            button.addEventListener('click', function () {
                incrementQuantity(this);
            });
        });

        var decrementButtons = document.querySelectorAll('.btn-decrement');
        decrementButtons.forEach(function (button) {
                    button.addEventListener('click', function () {
                decrementQuantity(this);
            });
        });

        
        attachAddToCartEventListeners();
    });
    </script>




</body>
</html>
