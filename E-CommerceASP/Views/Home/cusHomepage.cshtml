@{
    Layout = null;
}

@using System;
@using System.Collections.Generic;
@using System.Linq;
@using System.Web;
@using System.Web.Mvc;
@using System.Data;
@using System.Data.SqlClient;
@using System.IO;

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ByteZone - Home</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="~/Style/styles.css" rel="stylesheet" />
    <style>
        .dropdown-menu {
            z-index: 1000;
            position: absolute;
        }
    </style>
</head>
<body>

    <!-- Top Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container">
            <!-- Logo -->
            <a class="navbar-brand" href="https://localhost:44397/Home/cusHomepage">

                <img src="~/Scripts/images/OfficialLogo_ByteZone.png" />
            </a>
            <!-- Navbar toggler -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topNavbar"
                    aria-controls="topNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <!-- Navbar content -->
            <div class="collapse navbar-collapse justify-content-end" id="topNavbar">

                <div class="dropdown">
                    <button class="btn btn-secondary dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown"
                            aria-expanded="false">
                        @(Session["UserName"])
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                        <li><a class="dropdown-item" href="#" id="myaccountBtn">My Account</a></li>
                        <li><a class="dropdown-item" href="#" id="logoutBtn">Logout</a></li>
                    </ul>
                </div>

            </div>
        </div>
    </nav>

    <!-- Bottom Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-secondary fixed-top bottom-navbar" style="z-index: 900;">
        <div class="container">
            <!-- Navbar toggler -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#bottomNavbar"
                    aria-controls="bottomNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <!-- Navbar links -->
            <div class="collapse navbar-collapse justify-content-center" id="bottomNavbar">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="https://localhost:44397/Home/cusHomepage">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="https://localhost:44397/Home/cusProducts?searchQuery=">Products</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="https://localhost:44397/Home/cusAddToCart">My Cart</a>
                    </li>
                    
                </ul>
            </div>
        </div>
    </nav>
    <div class="jumbotron">
        <div class="container">

        </div>
    </div>
    <br>

    <div class="container">
        <h2>Featured Products</h2>
       
        <div class="row">
            @{
                string connStr = @"Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=C:\Users\Dennis\source\repos\E-CommerceASP\E-CommerceASP\App_Data\byteZone.mdf;Integrated Security=True";

                using (var db = new SqlConnection(connStr))
                {
                    db.Open();

                   
                    int[] productIds = new int[] { 9, 45, 10 };

                  
                    foreach (int productId in productIds)
                    {
                        using (var cmd = db.CreateCommand())
                        {
                            cmd.CommandType = CommandType.Text;
                            // Retrieve product data for the current product ID
                            cmd.CommandText = "SELECT * FROM PRODUCTS WHERE prod_ID = @productId";
                            cmd.Parameters.AddWithValue("@productId", productId);

                            using (var reader = cmd.ExecuteReader())
                            {
                                if (reader.Read())
                                {
                                    <div class="col-md-4">
                                        <div class="product-card">
                                            <div class="card">
                                                <h5 class="card-title">@reader["prod_name"]</h5>
                                                <img src="@Url.Action("Image", "Home", new { filename = reader["prod_img"] })" width="200" class="card-img-top" alt="@reader["prod_name"]">
                                                <div class="card-body">
                                                    <p class="card-text">@reader["prod_description"]</p>
                                                    
                                                    <a href="https://localhost:44397/Home/cusProducts?searchQuery=" class="btn btn-primary" onclick="showLoginModal()" data-product-id="@reader["prod_ID"]">View Details</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        }
                    }
                }
            }
        </div>
    </div>

    
    <div class="modal fade" id="updateUserInfoModal" tabindex="-1" aria-labelledby="updateUserInfoModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="updateUserInfoModalLabel">Update User Information</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="updateUserInfoForm">
                        <div class="mb-3">
                            <label for="updateFullName" class="form-label">Full Name</label>
                            <input type="text" class="form-control" id="updateFullName" placeholder="Full Name">
                        </div>
                        <div class="mb-3">
                            <label for="updateEmail" class="form-label">Email Address</label>
                            <input type="email" class="form-control" id="updateEmail" placeholder="Email Address">
                        </div>
                        <div class="mb-3">
                            <label for="updateAddress" class="form-label">Address</label>
                            <input type="text" class="form-control" id="updateAddress" placeholder="Address">
                        </div>
                        <div class="mb-3">
                            <label for="updatePhoneNumber" class="form-label">Phone Number</label>
                            <input type="text" class="form-control" id="updatePhoneNumber" placeholder="Phone Number" pattern="\d{11}" maxlength="11" >
                        </div>
                        <div class="mb-3">
                            <label for="updateBirthdate" class="form-label">Birthdate</label>
                            <input type="date" class="form-control" id="updateBirthdate" placeholder="Birthdate">
                        </div>
                        <div class="mb-3">
                            <label for="updatePassword" class="form-label">Password</label>
                            <input type="password" class="form-control" id="updatePassword" placeholder="Password" required>
                        </div>
                        <div class="mb-3">
                            <label for="updateConfirmPassword" class="form-label">Confirm Password</label>
                            <input type="password" class="form-control" id="updateConfirmPassword" placeholder="Confirm Password" required>
                        </div>
                        <div class="modal-footer justify-content-center">
                            <button type="submit" class="btn btn-primary">Update Information</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>


    
    <div class="modal fade" id="logoutSuccessModal" tabindex="-1" aria-labelledby="logoutSuccessModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="logoutSuccessModalLabel">Logout Success</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    You have been successfully logged out.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>


    <script src="~/Scripts/jquery-3.7.1.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@(Url.Content("@popperjs/core@2.9.2/dist/umd/popper.min.js"))"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#logoutBtn').click(function (e) {
                e.preventDefault();
                $('#logoutSuccessModal').modal('show');
                
                setTimeout(function () {
                    window.location.href = 'https://localhost:44397/Home/Homepage';
                }, 1000);
            });
        });

        function openUpdateUserInfoModal() {
            $.ajax({
                url: '/Home/GetCustomerData',
                type: 'GET',
                success: function (response) {
                    if (response.success) {
                        $('#updateFullName').val(response.customer.full_name);
                        $('#updateEmail').val(response.customer.email);
                        $('#updateAddress').val(response.customer.address);
                        $('#updatePhoneNumber').val(response.customer.phone_number);
                        $('#updateBirthdate').val(response.customer.birthdate);
                        $('#updateUserInfoModal').modal('show');
                    } else {
                        alert('Failed to load customer data: ' + response.message);
                    }
                },
                error: function (error) {
                    alert('An error occurred while loading customer data.');
                }
            });
        }

        $('#updateUserInfoForm').submit(function (event) {
            event.preventDefault();
            var formData = {
                full_name: $('#updateFullName').val(),
                email: $('#updateEmail').val(),
                address: $('#updateAddress').val(),
                phone_number: $('#updatePhoneNumber').val(),
                birthdate: $('#updateBirthdate').val(),
                password: $('#updatePassword').val(),
                confirm_password: $('#updateConfirmPassword').val()
            };

            $.ajax({
                url: '/Home/UpdateCustomerData',
                type: 'POST',
                data: formData,
                success: function (response) {
                    if (response.success) {
                        $('#updateUserInfoModal').modal('hide');
                        alert('Customer information updated successfully!');
                    } else {
                        alert('Failed to update customer information: ' + response.message);
                    }
                },
                error: function (error) {
                    alert('An error occurred while updating customer information.');
                }
            });
        });

        
        $(document).ready(function () {
            $('#myaccountBtn').click(function (e) {
                e.preventDefault();
                openUpdateUserInfoModal();
            });
        });



    </script>




</body>
</html>



