@{
    Layout = null;
}

@using System;
@using System.Collections.Generic;
@using System.Linq;
@using System.Web;
@using System.Web.Mvc;
@using System.Data;
@using System.Data.SqlClient;
@using System.IO;

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>ByteZone</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <link href="~/Style/adminStyles.css" rel="stylesheet" />
  
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container">
            
            <a class="navbar-brand" href="https://localhost:44397/Home/cusHomepage">
                <img src="~/Scripts/images/OfficialLogo_ByteZone.png" />
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topNavbar"
                    aria-controls="topNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
           
            <div class="collapse navbar-collapse justify-content-end" id="topNavbar">
                <div class="d-flex align-items-center">
                    
                    <form class="search-form mr-3">
                        <input class="form-control mr-sm-2 search-input" type="search" placeholder="Search" aria-label="Search" name="searchQuery">
                        <button class="btn btn-outline-light my-2 my-sm-0 search-button" type="submit">Search</button>
                    </form>

                    <div class="dropdown">
                        <button class="btn btn-secondary dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown"
                                aria-expanded="false">
                            Admin
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                            
                            <li><a class="dropdown-item" href="#" id="logoutBtn">Logout</a></li>
                        </ul>
                    </div>
                </div>
            </div>

        </div>
    </nav>
    
    <nav class="navbar navbar-expand-lg navbar-dark bg-secondary fixed-top bottom-navbar" style="z-index: 900;">
        <div class="container">
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#bottomNavbar"
                    aria-controls="bottomNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse justify-content-center" id="bottomNavbar">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="https://localhost:44397/Home/adminHomepage">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="https://localhost:44397/Home/Products?searchQuery=#">Products</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="https://localhost:44397/Home/customers#">Customers</a>
                    </li>
                    
                </ul>
            </div>
        </div>
    </nav>



    <div class="container">

        <h1 class="text-center my-4">Customers</h1>
        
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Username</th>
                    <th>Email Address</th>
                    <th>Name</th>
                    <th>Address</th>
                    <th>Phone Number</th>
                    <th>Birthdate</th>
                    <th>Created At</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="productTableBody">
                @{
                    string connStr = @"Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=C:\Users\Dennis\source\repos\E-CommerceASP\E-CommerceASP\App_Data\byteZone.mdf;Integrated Security=True";

                    using (var db = new SqlConnection(connStr))
                    {
                        db.Open();

                        using (var cmd = db.CreateCommand())
                        {
                            cmd.CommandType = CommandType.Text;
                            cmd.CommandText = @"
                                        SELECT * FROM CustomerAccount
                                        WHERE cus_username LIKE @searchQuery
                                        OR cus_email LIKE @searchQuery
                                        OR cus_fullname LIKE @searchQuery
                                        OR cus_address LIKE @searchQuery
                                        OR cus_phonenum LIKE @searchQuery
                                        OR cus_birthdate LIKE @searchQuery
                                        OR cus_createdate LIKE @searchQuery";

                            cmd.Parameters.AddWithValue("@searchQuery", "%" + Request.QueryString["searchQuery"] + "%");

                            using (var reader = cmd.ExecuteReader())
                            {
                                if (reader.HasRows)
                                {
                                    while (reader.Read())
                                    {
                                        <tr class="items">
                                            <td class="cus_ID"><label>@reader["cus_ID"]</label></td>
                                            <td class="prodName">@reader["cus_username"]</td>
                                            <td class="prodBrand">@reader["cus_email"]</td>
                                            <td class="prodBrand">@reader["cus_fullname"]</td>
                                            <td class="prodDesc" style="max-width: 325px;">@reader["cus_address"]</td>
                                            <td class="prodQuantity" style="text-align: center;">@reader["cus_phonenum"]</td>
                                            <td class="cus_birthdate">
                                                @{
                                                    DateTime date;
                                                    if (DateTime.TryParse(reader["cus_birthdate"].ToString(), out date))
                                                    {
                                                        @date.ToString("MM-dd-yyyy")
                                                    }
                                                    else
                                                    {
                                                        @reader["cus_birthdate"]
                                                    }
                                                }
                                            </td>>
                                            <td class="cus_createDate">
                                                @{
                                                    DateTime date1;
                                                    if (DateTime.TryParse(reader["cus_createdate"].ToString(), out date1))
                                                    {
                                                        @date1.ToString("MM-dd-yyyy")
                                                    }
                                                    else
                                                    {
                                                        @reader["cus_createdate"]
                                                    }
                                                }
                                            </td>
                                            <td style="white-space:nowrap">
                                                <a class="btn btn-danger btn-sm" href="#" data-bs-toggle="modal" data-bs-target="#deleteConfirmationModal" data-id="@reader["cus_ID"]">Delete</a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="9">No matching customers found.</td>
                                    </tr>
                                }
                            }
                        }
                    }
                }
            </tbody>
        </table>

    </div>


    <div class="modal fade" id="deleteConfirmationModal" tabindex="-1" aria-labelledby="deleteConfirmationModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteConfirmationModalLabel">Delete Customer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete this customer?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <a id="deleteConfirmationLink" href="" class="btn btn-danger">Confirm</a>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteSuccessModal" tabindex="-1" role="dialog" aria-labelledby="deleteSuccessModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteSuccessModalLabel">Customer Information Deleted Successfully</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    The product has been deleted successfully.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    
    

    <div class="modal fade" id="logoutSuccessModal" tabindex="-1" aria-labelledby="logoutSuccessModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="logoutSuccessModalLabel">Logout Success</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    You have been successfully logged out.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@(Url.Content("@popperjs/core@2.9.2/dist/umd/popper.min.js"))"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/jquery-3.7.1.js"></script>

    <script type="text/javascript">
    $(document).ready(function () {
        
        $('#logoutBtn').click(function (e) {
            e.preventDefault();
            $('#logoutSuccessModal').modal('show');
            setTimeout(function () {
                window.location.href = 'https://localhost:44397/Home/Homepage';
            }, 1000);
        });

        
        function deleteCustomer(id) {
            var deleteConfirmationModal = document.getElementById('deleteConfirmationModal');
            var deleteConfirmationLink = deleteConfirmationModal.querySelector('#deleteConfirmationLink');
            deleteConfirmationLink.href = '@Url.Action("DeleteCustomer", "Home")?id=' + id;
        }

        
        var deleteButtons = document.querySelectorAll('.btn-danger.btn-sm');
        deleteButtons.forEach(function (button) {
            button.addEventListener('click', function () {
                var id = this.getAttribute('data-id');
                deleteCustomer(id);
                $('#deleteConfirmationModal').modal('show');
            });
        });
    });
    </script>





</body>
</html>
