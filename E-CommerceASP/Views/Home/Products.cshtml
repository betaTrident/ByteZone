@{
    Layout = null;
}

@using System;
@using System.Collections.Generic;
@using System.Linq;
@using System.Web;
@using System.Web.Mvc;
@using System.Data;
@using System.Data.SqlClient;
@using System.IO;

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>ByteZone</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <link href="~/Style/adminStyles.css" rel="stylesheet" />
  
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container">

            <a class="navbar-brand" href="https://localhost:44397/Home/adminHomepage">
                <img src="~/Scripts/images/OfficialLogo_ByteZone.png" />
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topNavbar"
                    aria-controls="topNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-end" id="topNavbar">

                <form class="search-form">
                    <input class="form-control mr-sm-2 search-input" type="search" placeholder="Search" aria-label="Search" name="searchQuery">
                    <button class="btn btn-outline-light my-2 my-sm-0 search-button" type="submit">Search</button>
                </form>
                <div class="dropdown">
                    <button class="btn btn-secondary dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown"
                            aria-expanded="false">
                        Admin
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">

                        <li><a class="dropdown-item" href="#" id="logoutBtn">Logout</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <nav class="navbar navbar-expand-lg navbar-dark bg-secondary fixed-top bottom-navbar" style="z-index: 900;">
        <div class="container">

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#bottomNavbar"
                    aria-controls="bottomNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-center" id="bottomNavbar">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="https://localhost:44397/Home/adminHomepage">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="https://localhost:44397/Home/Products?searchQuery=#">Products</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="https://localhost:44397/Home/customers">Customers</a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>



    <div class="container">

        <h1 class="text-center my-4">Products</h1>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#staticBackdrop">
                Create Product
            </button>
            <div class="dropdown">
                <button class="btn btn-secondary dropdown-toggle" type="button" id="sortDropdownButton" data-bs-toggle="dropdown" aria-expanded="false">
                    Sort By
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="sortDropdownButton">
                    <li><button class="dropdown-item sort-btn" data-sort="prod_ID">ID</button></li>
                    <li><button class="dropdown-item sort-btn" data-sort="prod_name">Name</button></li>
                    <li><button class="dropdown-item sort-btn" data-sort="prod_brand">Brand</button></li>
                    <li><button class="dropdown-item sort-btn" data-sort="prod_category">Category</button></li>
                    <li><button class="dropdown-item sort-btn" data-sort="prod_quantity">Quantity</button></li>
                    <li><button class="dropdown-item sort-btn" data-sort="prod_price">Price</button></li>
                    <li><button class="dropdown-item sort-btn" data-sort="prod_createDate">Created At</button></li>
                </ul>
            </div>
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Brand</th>
                    <th>Category</th>
                    <th>Quantity</th>
                    <th>Price</th>
                    <th>Image</th>
                    <th>Created At</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="productTableBody">
                @{
                    string connStr = @"Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=C:\Users\Dennis\source\repos\E-CommerceASP\E-CommerceASP\App_Data\byteZone.mdf;Integrated Security=True";

                    using (var db = new SqlConnection(connStr))
                    {
                        db.Open();

                        using (var cmd = db.CreateCommand())
                        {
                            cmd.CommandType = CommandType.Text;
                            cmd.CommandText = @"
                                            SELECT * FROM PRODUCTS
                                            WHERE
                                                prod_name LIKE @searchQuery
                                                OR prod_ID LIKE @searchQuery
                                                OR prod_brand LIKE @searchQuery
                                                OR prod_category LIKE @searchQuery";
                            cmd.Parameters.AddWithValue("@searchQuery", "%" + Request.QueryString["searchQuery"] + "%");

                            using (var reader = cmd.ExecuteReader())
                            {
                                if (reader.HasRows)
                                {
                                    while (reader.Read())
                                    {
                                        <tr class="items">
                                            <td class="prodId"><label>@reader["prod_ID"]</label></td>
                                            <td class="prodName">@reader["prod_name"]</td>
                                            <td class="prodBrand">@reader["prod_brand"]</td>
                                            <td class="prodCat">@reader["prod_category"]</td>
                                            <td class="prodQuantity">@reader["prod_quantity"]</td>
                                            <td class="prodPrice">₱ @reader["prod_price"]</td>
                                            <td class="prodImg">
                                                <img src="@Url.Action("Image", "Home", new { filename = reader["prod_img"] })" width="100" />
                                            </td>
                                            <td class="prodCreatedAt">
                                                @{
                                                    DateTime date;
                                                    if (DateTime.TryParse(reader["prod_createDate"].ToString(), out date))
                                                    {
                                                        @date.ToString("MM-dd-yyyy")
                                                    }
                                                    else
                                                    {
                                                        @reader["prod_createDate"]
                                                    }
                                                }
                                            </td>
                                            <td style="white-space:nowrap">
                                                <a class="btn btn-primary btn-sm btn-update" href="javascript:void(0);" data-id="@reader["prod_ID"]">Update</a>

                                                <a class="btn btn-danger btn-sm" href="#" data-bs-toggle="modal" data-bs-target="#deleteConfirmationModal" data-id="@reader["prod_ID"]">Delete</a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="9">No matching products found.</td>
                                    </tr>
                                }
                            }
                        }
                    }
                }
            </tbody>

        </table>
    </div>



    <div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="staticBackdropLabel">Create New Product</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="productForm" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input class="form-control" id="prodName" name="prodName" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Brand</label>
                            <input class="form-control" id="prodBrand" name="prodBrand" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Category</label>
                            <select class="form-select" id="prodCategory" name="prodCategory" required>
                                <option value="Other">Other</option>
                                <option value="Phones">Phones</option>
                                <option value="Laptops">Laptops</option>
                                <option value="Computers">Computers</option>
                                <option value="Accessories">Accessories</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Price</label>
                            <input class="form-control" id="prodPrice" name="prodPrice" type="number" step="0.01" min="1" value="0.0" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <input class="form-control" id="prodDesc" name="prodDesc" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Quantity</label>
                            <input class="form-control" id="prodQuantity" name="prodQuantity" type="number" min="1" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Product Image</label>
                            <input class="form-control" id="prodImg" name="prodImg" type="file" accept="image/png,image/jpeg,image/jpg,image/gif,image/bmp" required />
                        </div>
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            <button type="submit" class="btn btn-primary">Submit</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>



    <div class="modal fade" id="createSuccessModal" tabindex="-1" aria-labelledby="createSuccessModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="createSuccessModalLabel">Success</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Product created successfully.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>


    <div class="modal fade" id="deleteConfirmationModal" tabindex="-1" aria-labelledby="deleteConfirmationModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteConfirmationModalLabel">Delete Product</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete this product?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <a id="deleteConfirmationLink" href="" class="btn btn-danger">Confirm</a>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteSuccessModal" tabindex="-1" role="dialog" aria-labelledby="deleteSuccessModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteSuccessModalLabel">Product Deleted</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    The product has been deleted successfully.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="updateModal" tabindex="-1" aria-labelledby="updateModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="updateModalLabel">Update Product</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="updateForm" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input class="form-control" id="updateProdName" name="prodName" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Brand</label>
                            <input class="form-control" id="updateProdBrand" name="prodBrand" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Category</label>
                            <select class="form-select" id="updateProdCategory" name="prodCategory">
                                <option value="Other">Other</option>
                                <option value="Phones">Phones</option>
                                <option value="Laptops">Laptops</option>
                                <option value="Computers">Computers</option>
                                <option value="Accessories">Accessories</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Price</label>
                            <input class="form-control" id="updateProdPrice" name="prodPrice" type="number" step="0.01" min="1" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <input class="form-control" id="updateProdDesc" name="prodDesc" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Quantity</label>
                            <input class="form-control" id="updateProdQuantity" name="prodQuantity" type="number" min="0" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Product Image</label>
                            <input class="form-control" id="updateProdImg" name="prodImg" type="file" accept="image/*" />
                            <img id="prodImgPreview" src="" alt="Product Image" style="width: 100px; height: auto; margin-top: 10px;" />
                        </div>
                        <input type="hidden" id="updateProdId" name="prodID" />
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            <button type="submit" class="btn btn-primary">Update</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="logoutSuccessModal" tabindex="-1" aria-labelledby="logoutSuccessModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="logoutSuccessModalLabel">Logout Success</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    You have been successfully logged out.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>



    <script src="https://cdn.jsdelivr.net/npm/@(Url.Content("@popperjs/core@2.9.2/dist/umd/popper.min.js"))"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/jquery-3.7.1.js"></script>

    <script type="text/javascript">
    $(document).ready(function () {

        $('#productForm').on('submit', function (e) {
            e.preventDefault();

            var formData = new FormData(this);

            $.ajax({
                type: 'POST',
                url: '../Home/ProductEntryForm',
                data: formData,
                contentType: false,
                processData: false,
                success: function (response) {
                    $('#createSuccessModal').modal('show');
                    setTimeout(function () {
                        $('#createSuccessModal').modal('hide');
                        location.reload();
                    }, 2000);
                },
                error: function (error) {
                    alert('There was an error creating the product. Please try again.');
                }
            });
        });

        function openUpdateModal(prod_ID) {
            $.ajax({
                url: '/Home/GetProductData',
                type: 'GET',
                data: { prod_ID: prod_ID },
                success: function (response) {
                    if (response.success) {
                        $('#updateProdId').val(response.product.prod_ID);
                        $('#updateProdName').val(response.product.prod_name);
                        $('#updateProdBrand').val(response.product.prod_brand);
                        $('#updateProdCategory').val(response.product.prod_category);
                        $('#updateProdPrice').val(response.product.prod_price);
                        $('#updateProdDesc').val(response.product.prod_description);
                        $('#updateProdQuantity').val(response.product.prod_quantity);
                        $('#prodImgPreview').attr('src', '/Images/' + response.product.prod_img);
                        $('#updateModal').modal('show');
                    } else {
                        alert('Failed to load product data: ' + response.message);
                    }
                },
                error: function (error) {
                    alert('An error occurred while loading product data.');
                }
            });
        }

        $('#updateForm').submit(function (event) {
            event.preventDefault();
            var formData = new FormData(this);

            $.ajax({
                url: '/Home/UpdateProduct',
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.success) {
                        $('#updateModal').modal('hide');
                        alert('Product updated successfully!');
                        location.reload();
                    } else {
                        alert('Failed to update product: ' + response.message);
                    }
                },
                error: function (error) {
                    alert('An error occurred while updating the product.');
                }
            });
        });

        $(document).on('click', '.btn-update', function () {
            var prod_ID = $(this).data('id');
            openUpdateModal(prod_ID);
        });


        $('.sort-btn').click(function () {
            var sortBy = $(this).data('sort');
            sortTable(sortBy);
        });


        function deleteProduct(id) {
            var deleteConfirmationModal = document.getElementById('deleteConfirmationModal');
            var deleteConfirmationLink = deleteConfirmationModal.querySelector('#deleteConfirmationLink');
            deleteConfirmationLink.href = '@Url.Action("Delete", "Home")?id=' + id;
        }


        function sortTable(sortBy) {
            $.ajax({
                url: '@Url.Action("GetSortedProducts", "Home")',
                type: 'GET',
                data: { sortBy: sortBy },
                success: function (data) {

                    $('#productTableBody').empty();

                    $.each(data, function (index, product) {
                        var row = $('<tr class="items"></tr>');
                        row.append('<td class="prodId">' + product.prod_ID + '</td>');
                        row.append('<td class="prodName">' + product.prod_name + '</td>');
                        row.append('<td class="prodBrand">' + product.prod_brand + '</td>');
                        row.append('<td class="prodCat">' + product.prod_category + '</td>');
                        row.append('<td class="prodQuantity">' + product.prod_quantity + '</td>');
                        row.append('<td class="prodPrice">₱' + product.prod_price + '</td>');
                        row.append('<td class="prodImg"><img src="' + product.prod_img + '" width="100"></td>');
                        row.append('<td class="prodCreatedAt">' + product.prod_createDate + '</td>');
                        row.append('<td style="white-space:nowrap"><a class="btn btn-primary btn-sm" href="javascript:void(0);" data-id="' + product.prod_ID + '">Update</a> <a class="btn btn-danger btn-sm" href="#" data-bs-toggle="modal" data-bs-target="#deleteConfirmationModal" data-id="' + product.prod_ID + '">Delete</a></td>');
                        $('#productTableBody').append(row);
                    });
                },
                error: function (error) {
                    alert('Failed to sort products!');
                }
            });
        }


        var deleteButtons = document.querySelectorAll('.btn-danger.btn-sm');
        deleteButtons.forEach(function (button) {
            button.addEventListener('click', function () {
                var id = this.getAttribute('data-id');
                deleteProduct(id);
                $('#deleteConfirmationModal').modal('show');
            });
        });

        $(document).ready(function () {
            $('#logoutBtn').click(function (e) {
                e.preventDefault();
                $('#logoutSuccessModal').modal('show');

                setTimeout(function () {
                    window.location.href = 'https://localhost:44397/Home/Homepage';
                }, 1000);
            });
        });





    });
    </script>


</body>
</html>
